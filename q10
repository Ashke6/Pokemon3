2B: App.java. Click Yes again.
notepad src\main\java\com\example\App.java

package com.example;

public class App {
    public static int add(int a, int b) {
        return a + b;
    }

    public static void main(String[] args) {
        System.out.println(add(10, 20));
    }
}


2C: AppTest.java. Click Yes again.
notepad src\test\java\com\example\AppTest.java

package com.example;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;

class AppTest {

    @Test
    void addsPositiveNumbers() {
        assertEquals(30, App.add(10, 20));
    }

    @Test
    void addsZero() {
        assertEquals(7, App.add(7, 0));
    }

    @Test
    void addsNegativeNumbers() {
        assertEquals(-5, App.add(-2, -3));
    }
}

